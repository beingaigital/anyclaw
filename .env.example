# AnyClaw 环境变量模板：复制为 .env 并填入你的 API Key
# 变量名约定为 *_APIKEY（与 config/model.yaml 的 api_key_env 对应）

# OpenAI
OPENAI_APIKEY=your_openai_api_key

# DeepSeek（默认 main 模型）
DEEPSEEK_APIKEY=your_deepseek_api_key

# Qwen / DashScope（OpenAI 兼容模式）
QWEN_APIKEY=your_qwen_api_key

# Gemini（需安装 [gemini] extra）
GEMINI_APIKEY=your_gemini_api_key

# Kimi / Moonshot
KIMI_APIKEY=your_kimi_api_key